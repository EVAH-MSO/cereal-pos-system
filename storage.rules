rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default rule - authenticated users only
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Product images - anyone can read, only authenticated can upload/delete
    match /products/{image} {
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Product images by product ID
    match /products/{productId}/{image} {
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Sales receipts - only authenticated users
    match /receipts/{receipt} {
      allow read, write: if request.auth != null;
    }
    
    // Sales receipts by date
    match /receipts/{year}/{month}/{receipt} {
      allow read, write: if request.auth != null;
    }
    
    // Customer uploads - only the customer who uploaded
    match /customers/{customerId}/{file} {
      allow read: if request.auth != null && request.auth.uid == customerId;
      allow write: if request.auth != null && request.auth.uid == customerId;
    }
    
    // Temporary uploads - anyone can upload, but auto-delete after 1 day
    match /temp/{allPaths=**} {
      allow read, write: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Profile pictures - only the user can upload their own
    match /profiles/{userId}/{image} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Backups - only admins (you can add custom claims)
    match /backups/{backup} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}